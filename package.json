{
  "name": "growi-plugin-custom-toc",
  "version": "1.0.0",
  "type": "module",
  "description": "Custom TOC generator for GROWI",
  "scripts": {
    "build": "tsc && vite build"
  },
  "growiPlugin": {
    "schemaVersion": "4",
    "types": [
      "client-app"
    ],
    "entries": {
      "client-app": "./dist/client-entry.js"
